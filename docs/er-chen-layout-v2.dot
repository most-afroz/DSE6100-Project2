    o_quote [label="quote_id (FK, UNIQUE)", pos="454,-334!", pin=true];
    o_client [label="client_id (FK)", pos="472,-309!", pin=true];
    o_address [label="service_address", pos="466,-397!", pin=true];
    o_price [label="agreed_price", pos="472,-422!", pin=true];
    o_start [label="scheduled_start", pos="467,-447!", pin=true];
    o_end [label="scheduled_end", pos="769,-359!", pin=true];
    o_status [label="status", pos="763,-334!", pin=true];
    o_created [label="created_at", pos="763,-309!", pin=true];
    o_install [label="actual_install_date", pos="777,-397!", pin=true];
    o_completion [label="completion_date", pos="772,-422!", pin=true];
    o_note [label="completion_note", pos="772,-447!", pin=true];
    // ORDER ITEM
