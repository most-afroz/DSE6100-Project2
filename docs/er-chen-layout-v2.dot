    bi_id [label=<<U>bill_item_id</U>>, fillcolor="#FFF0D6", color="#B8862B", penwidth=1.2, pos="209,-953!", pin=true];
    bi_bill [label="bill_id (FK)", pos="209,-928!", pin=true];
