    rm_current [label="current_flooring", pos="1325,-606!", pin=true];
    rm_removal [label="removal_required", pos="1329,-694!", pin=true];
    rm_pattern [label="install_pattern", pos="1323,-719!", pin=true];
    // REQUEST PHOTO
    ph_id [label=<<U>photo_id</U>>, fillcolor="#FFF0D6", color="#B8862B", penwidth=1.2, pos="1892,-62!", pin=true];
    ph_request [label="request_id (FK)", pos="1898,-37!", pin=true];
    ph_number [label="photo_no", pos="1892,-12!", pin=true];
    ph_file [label="file_name", pos="1892,-100!", pin=true];
    ph_uploaded [label="uploaded_at", pos="1893,-125!", pin=true];
    // QUOTE ITEM
    qi_id [label=<<U>quote_item_id</U>>, fillcolor="#FFF0D6", color="#B8862B", penwidth=1.2, pos="1600,-656!", pin=true];
    qi_quote [label="quote_id (FK)", pos="1602,-631!", pin=true];
    qi_type [label="item_type", pos="1604,-606!", pin=true];
    qi_room [label="room_id (FK, nullable)", pos="1584,-694!", pin=true];
    qi_product [label="product_id (FK, nullable)", pos="1579,-719!", pin=true];
    qi_description [label="description", pos="1604,-744!", pin=true];
    qi_area [label="area_sqft", pos="1892,-656!", pin=true];
    qi_quantity [label="quantity", pos="1892,-631!", pin=true];
