    pay_amount [label="amount", pos="209,-606!", pin=true];
    pay_date [label="paid_at", pos="209,-694!", pin=true];
    pay_last4 [label="card_last4", pos="209,-719!", pin=true];

    // ==========================================
    // RELATIONSHIP CONNECTIONS
    // ==========================================

    // Blue: client and request flow
    edge [color="#4776A8", constraint=true, arrowhead=none, penwidth=0.8];
    Client -> Submits [penwidth=1, dir=back, arrowtail=normal];
    Request -> Submits [penwidth=3];
    Client -> Places [penwidth=1, dir=back, arrowtail=normal];
    Order -> Places [penwidth=3];
    Request -> w_Contains_Request_0 [penwidth=1, dir=back, arrowtail=normal];
    w_Contains_Request_0 -> w_Contains_Request_1 [penwidth=1];
    w_Contains_Request_1 -> Contains [penwidth=1];
    Room -> w_Contains_Room_0 [penwidth=3];
    w_Contains_Room_0 -> w_Contains_Room_1 [penwidth=3];
    w_Contains_Room_1 -> Contains [penwidth=3];
    Request -> HasPhoto [penwidth=1, dir=back, arrowtail=normal];
    Photo -> HasPhoto [penwidth=3];

    // Teal: product and room relationships
    edge [color="#3F8275"];
    Product -> BelongsTo [penwidth=3];
    BelongsTo -> Category [penwidth=1, arrowhead=normal];
    Room -> Wants [penwidth=3];
    Wants -> Product [penwidth=1, arrowhead=normal];
    QItem -> ForRoom [penwidth=1];
    ForRoom -> Room [penwidth=1, arrowhead=normal];
    QItem -> w_OfProduct_QItem_0 [penwidth=1];
    w_OfProduct_QItem_0 -> OfProduct [penwidth=1];
    OfProduct -> w_OfProduct_Product_0 [penwidth=1];
    w_OfProduct_Product_0 -> Product [penwidth=1, arrowhead=normal];
    OItem -> Installs [penwidth=3];
    Installs -> Room [penwidth=1, arrowhead=normal];
    OItem -> w_Uses_OItem_0 [penwidth=3];
    w_Uses_OItem_0 -> Uses [penwidth=3];
    Uses -> w_Uses_Product_0 [penwidth=3];
    w_Uses_Product_0 -> Product [penwidth=1, arrowhead=normal];

    // Purple: quote workflow
    edge [color="#8063A6"];
    Request -> w_QuotedIn_Request_0 [penwidth=1, dir=back, arrowtail=normal];
    w_QuotedIn_Request_0 -> QuotedIn [penwidth=1];
    Quote -> w_QuotedIn_Quote_0 [penwidth=3];
    w_QuotedIn_Quote_0 -> QuotedIn [penwidth=3];
    Quote -> Itemizes [penwidth=1, dir=back, arrowtail=normal];
    QItem -> Itemizes [penwidth=3];
    NMsg -> Answers [penwidth=1];
    Answers -> Quote [penwidth=1, arrowhead=normal];
    Quote -> w_Becomes_Quote_0 [penwidth=1, dir=back, arrowtail=normal];
    w_Becomes_Quote_0 -> Becomes [penwidth=1];
    Becomes -> w_Becomes_Order_0 [penwidth=1];
    w_Becomes_Order_0 -> Order [penwidth=3, arrowhead=normal];

    // Pink: communication
    edge [color="#A65D80"];
    NMsg -> About [penwidth=3];
    About -> Request [penwidth=1, arrowhead=normal];
    Bill -> Discusses [penwidth=1, dir=back, arrowtail=normal];
    BMsg -> Discusses [penwidth=3];

    // Orange: order and installation flow
    edge [color="#B87935"];
    Order -> Includes [penwidth=1, dir=back, arrowtail=normal];
    OItem -> Includes [penwidth=3];
    Order -> BilledBy [penwidth=1, dir=back, arrowtail=normal];
    Bill -> BilledBy [penwidth=3];

    // Green: billing and payment
    edge [color="#63864C"];
    Bill -> w_Lists_Bill_0 [penwidth=1, dir=back, arrowtail=normal];
    w_Lists_Bill_0 -> Lists [penwidth=1];
    BItem -> w_Lists_BItem_0 [penwidth=3];
    w_Lists_BItem_0 -> Lists [penwidth=3];
    Bill -> PaidBy [penwidth=1, dir=back, arrowtail=normal];
    PaidBy -> Payment [penwidth=3, arrowhead=normal];

    // Invisible bend points used to route edges around other nodes
    node [shape=point, width=0.01, height=0.01, style=invis, label=""];
    w_Contains_Request_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="1118,-205!"];
    w_Contains_Request_1 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="955,-205!"];
    w_Contains_Room_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="1118,-527!"];
    w_Contains_Room_1 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="955,-527!"];
    w_OfProduct_QItem_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="1708,-841!"];
    w_OfProduct_Product_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="1223,-841!"];
    w_Uses_OItem_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="659,-841!"];
    w_Uses_Product_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="1123,-841!"];
    w_QuotedIn_Request_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="1223,-181!"];
    w_QuotedIn_Quote_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="1798,-181!"];
    w_Becomes_Quote_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="1698,-253!"];
    w_Becomes_Order_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="669,-253!"];
    w_Lists_Bill_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="-35,-378!"];
    w_Lists_BItem_0 [shape=point, width=0.01, height=0.01, style=invis, pin=true, label="", pos="-35,-972!"];

    // ==========================================
    // NOTES AND LEGEND
    // ==========================================

    node [
        shape=note,
        style=filled,
        fillcolor="#F5F7FA",
        color="#A0AAB5",
        fontsize=7,
        fixedsize=false,
        width=0.5,
        height=0.3,
        margin=0.08
    ];

    ContractorNote [
        label="Contractor is an independent login entity.\nNo foreign-key relationships connect it to other tables.",
        pos="1553,-972!", pin=true
    ];

    ViewNote [
        label="request_area is a SQL VIEW, not a table.\nIt derives total_sqft and room_count from request_room.",
        pos="1173,55!", pin=true
    ];

    Legend [
        label="CHEN NOTATION\nRectangle = Entity\nDiamond = Relationship\nOval = Attribute\nUnderlined = Primary key\nDashed oval = Derived attribute\nThin line = Partial participation\nThick line = Total participation\nThin arrow = At most one\nThick arrow = Exactly one",
        pos="1793,-860!", pin=true
    ];

    LegendColors [
        label="CONNECTIVITY COLORS\nBlue = Client / Request\nTeal = Product / Room\nPurple = Quote workflow\nPink = Messages\nOrange = Orders / Installation\nGreen = Billing / Payment",
        pos="1793,-1070!", pin=true
    ];

    Contractor -> ContractorNote [style=dotted, color="#8995A3", penwidth=0.7, constraint=false];
    Request -> ViewNote [style=dotted, color="#8995A3", penwidth=0.7, constraint=false];

    // ==========================================
    // ATTRIBUTE CONNECTORS
    // ==========================================

    edge [
        arrowhead=none,
        color="#9A8AAE",
        penwidth=0.65,
        constraint=false
    ];

    Contractor -> {c_id c_username c_password c_name};

    Client -> {
        cl_id cl_first cl_last cl_address cl_phone cl_email
        cl_password cl_holder cl_card cl_month cl_year cl_registered
    };

    Category -> {cat_id cat_name};

    Product -> {
        p_id p_category p_name p_brand p_style p_color
        p_price p_unit p_length p_width p_coverage p_description
        p_active
    };

    Quote -> {
        q_id q_request q_version q_created q_waste q_material
        q_labor q_other q_total q_start q_end q_note
        q_status q_decided
    };

    Request -> {
        r_id r_client r_address r_start r_end r_budget
        r_note r_status r_created r_total r_count
    };

    Room -> {
        rm_id rm_request rm_name rm_type rm_length rm_width
        rm_sqft rm_product rm_current rm_removal rm_pattern
    };

    Photo -> {ph_id ph_request ph_number ph_file ph_uploaded};

    QItem -> {
        qi_id qi_quote qi_type qi_room qi_product qi_description
        qi_area qi_quantity qi_unit qi_price qi_amount
    };

    NMsg -> {
        nm_id nm_request nm_quote nm_sender nm_type nm_message
        nm_created
    };

    Order -> {
        o_id o_quote o_client o_address o_price o_start
        o_end o_status o_created o_install o_completion o_note
    };

    OItem -> {
        oi_id oi_order oi_room oi_product oi_installed oi_est
        oi_actual oi_price
    };

    Bill -> {
        b_id b_order b_version b_created b_amount b_note
        b_status
    };

    BItem -> {bi_id bi_bill bi_type bi_description bi_amount};

    BMsg -> {
        bm_id bm_bill bm_sender bm_type bm_message bm_created
    };

    Payment -> {pay_id pay_bill pay_amount pay_date pay_last4};

}