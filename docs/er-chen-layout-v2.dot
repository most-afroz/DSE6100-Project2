    bm_sender [label="sender", pos="209,-12!", pin=true];
    bm_type [label="msg_type", pos="209,-100!", pin=true];
    bm_message [label="message", pos="209,-125!", pin=true];
    bm_created [label="created_at", pos="209,-150!", pin=true];
