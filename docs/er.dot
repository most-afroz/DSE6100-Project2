graph ER {
  graph [layout=neato, overlap=false, sep="+12", esep="+6", splines=true, nodesep=0.35, ranksep=0.55, fontname="Helvetica", pad=0.3];
  node  [fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9];

  node [shape=plaintext];
  Client   [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Client</B></TD></TR><TR><TD><U>client_id</U></TD></TR><TR><TD>first_name, last_name</TD></TR><TR><TD>address, phone, email</TD></TR><TR><TD>card_holder, card_number, card_exp</TD></TR><TR><TD>registered_at</TD></TR></TABLE>>];
  Category [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Category</B></TD></TR><TR><TD><U>category_id</U></TD></TR><TR><TD>category_name</TD></TR></TABLE>>];
  Product  [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Product</B></TD></TR><TR><TD><U>product_id</U></TD></TR><TR><TD>product_name, brand</TD></TR><TR><TD>material_style, color</TD></TR><TR><TD>unit_price, pricing_unit</TD></TR><TR><TD>length_in, width_in, sqft_per_unit</TD></TR><TR><TD>description, is_active</TD></TR></TABLE>>];
  Request  [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>FlooringRequest</B></TD></TR><TR><TD><U>request_id</U></TD></TR><TR><TD>service_address</TD></TR><TR><TD>pref_start, pref_end</TD></TR><TR><TD>budget, note, status</TD></TR><TR><TD>created_at</TD></TR><TR><TD><I>total_sqft (derived)</I></TD></TR></TABLE>>];
  Room     [label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Room / Area</B></TD></TR><TR><TD><U>room_name</U> (partial key)</TD></TR><TR><TD>room_type</TD></TR><TR><TD>length, width, sqft</TD></TR><TR><TD>current_flooring</TD></TR><TR><TD>removal_required, pattern</TD></TR></TABLE>>];
  Photo    [label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Photo</B></TD></TR><TR><TD><U>photo_no</U> (1..5)</TD></TR><TR><TD>file_name, uploaded_at</TD></TR></TABLE>>];
  Quote    [label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Quote</B></TD></TR><TR><TD><U>version_no</U> (partial key)</TD></TR><TR><TD>created_at, waste_pct</TD></TR><TR><TD>material_cost, labor_cost</TD></TR><TR><TD>other_cost, total_price</TD></TR><TR><TD>proposed_start/end, note</TD></TR><TR><TD>status, decided_at</TD></TR></TABLE>>];
  QItem    [label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>QuoteItem</B></TD></TR><TR><TD><U>item_no</U></TD></TR><TR><TD>item_type, description</TD></TR><TR><TD>area_sqft, quantity, unit</TD></TR><TR><TD>unit_price, amount</TD></TR></TABLE>>];
  NMsg     [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>NegotiationMessage</B></TD></TR><TR><TD><U>message_id</U></TD></TR><TR><TD>sender, msg_type</TD></TR><TR><TD>message, created_at</TD></TR></TABLE>>];
  Order    [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Order</B></TD></TR><TR><TD><U>order_id</U></TD></TR><TR><TD>service_address, agreed_price</TD></TR><TR><TD>scheduled_start/end, status</TD></TR><TR><TD>actual_install_date</TD></TR><TR><TD>completion_date, completion_note</TD></TR></TABLE>>];
  OItem    [label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>OrderItem</B></TD></TR><TR><TD>installed_sqft</TD></TR><TR><TD>est_qty_sqft, actual_qty_sqft</TD></TR><TR><TD>unit_price_sqft</TD></TR></TABLE>>];
  Bill     [label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Bill</B></TD></TR><TR><TD><U>version_no</U> (partial key)</TD></TR><TR><TD>created_at, amount_due</TD></TR><TR><TD>note, status</TD></TR></TABLE>>];
  BItem    [label=<<TABLE BORDER="3" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>BillItem</B></TD></TR><TR><TD><U>item_no</U></TD></TR><TR><TD>item_type, description, amount</TD></TR></TABLE>>];
  BMsg     [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>BillMessage</B></TD></TR><TR><TD><U>message_id</U></TD></TR><TR><TD>sender, msg_type</TD></TR><TR><TD>message, created_at</TD></TR></TABLE>>];
  Payment  [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf6ec"><TR><TD><B>Payment</B></TD></TR><TR><TD><U>payment_id</U></TD></TR><TR><TD>amount, paid_at, card_last4</TD></TR></TABLE>>];

  node [shape=diamond, style=filled, fillcolor="#e8eef7", fontsize=9, width=1.1, height=0.6];
  Submits; BelongsTo [label="Belongs\nTo"]; Wants;
  Contains [peripheries=2]; HasPhoto [label="Has\nPhoto", peripheries=2]; QuotedIn [label="Quoted\nIn", peripheries=2];
  Itemizes [peripheries=2]; ForRoom [label="For\nRoom"]; OfProduct [label="Of\nProduct"];
  About; Answers; Becomes; Includes [peripheries=2]; Installs; Uses;
  BilledBy [label="Billed\nBy", peripheries=2]; Lists [peripheries=2]; Discusses; PaidBy [label="Paid\nBy"];

  // style: K = key constraint (arrow), T = total participation (thick)
  edge [penwidth=1];
  Client -- Submits;
  Request -- Submits [dir=forward, arrowhead=normal, penwidth=3];
  Product -- BelongsTo [dir=forward, penwidth=3];
  Category -- BelongsTo;
  Request -- Contains [penwidth=3];
  Room -- Contains [dir=forward, penwidth=3];
  Room -- Wants [dir=forward, penwidth=3];
  Product -- Wants;
  Request -- HasPhoto;
  Photo -- HasPhoto [dir=forward, penwidth=3];
  Request -- QuotedIn;
  Quote -- QuotedIn [dir=forward, penwidth=3];
  Quote -- Itemizes [penwidth=3];
  QItem -- Itemizes [dir=forward, penwidth=3];
  QItem -- ForRoom [dir=forward];
  Room -- ForRoom;
  QItem -- OfProduct [dir=forward];
  Product -- OfProduct;
  NMsg -- About [dir=forward, penwidth=3];
  Request -- About;
  NMsg -- Answers [dir=forward];
  Quote -- Answers;
  Quote -- Becomes [dir=forward];
  Order -- Becomes [dir=forward, penwidth=3];
  Order -- Includes [penwidth=3];
  OItem -- Includes [dir=forward, penwidth=3];
  OItem -- Installs [dir=forward, penwidth=3];
  Room -- Installs;
  OItem -- Uses [dir=forward, penwidth=3];
  Product -- Uses;
  Order -- BilledBy;
  Bill -- BilledBy [dir=forward, penwidth=3];
  Bill -- Lists [penwidth=3];
  BItem -- Lists [dir=forward, penwidth=3];
  Bill -- Discusses;
  BMsg -- Discusses [dir=forward, penwidth=3];
  Bill -- PaidBy [dir=forward];
  Payment -- PaidBy [dir=forward, penwidth=3];

  Legend [shape=plaintext, label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="3" BGCOLOR="white">
   <TR><TD COLSPAN="1"><B>Notation</B></TD></TR>
   <TR><TD ALIGN="LEFT">arrow  E → R : key constraint (each E in at most one R)</TD></TR>
   <TR><TD ALIGN="LEFT">thick line : total participation (each E in at least one R)</TD></TR>
   <TR><TD ALIGN="LEFT">thick arrow : exactly one</TD></TR>
   <TR><TD ALIGN="LEFT">thick border box + double diamond : weak entity and its identifying relationship</TD></TR>
   <TR><TD ALIGN="LEFT">underlined : key / partial key</TD></TR></TABLE>>];
}
